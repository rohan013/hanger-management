# AI Provider
# Swap AI_PROVIDER to switch models (e.g., "openai", "claude") — implement src/lib/ai/<provider>.ts
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Vercel Postgres — copy from Vercel dashboard > Storage > Postgres > .env.local tab
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NO_SSL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Vercel Blob — copy from Vercel dashboard > Storage > Blob > .env.local tab
BLOB_READ_WRITE_TOKEN=
